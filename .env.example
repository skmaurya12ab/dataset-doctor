# ==============================================================================
# Dataset Doctor - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values for your environment.
# Do NOT commit '.env' to version control.

# Application Settings
APP_NAME="Dataset Doctor"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL 16 Async via asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataset_doctor

# File Ingestion & Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=100

# AI Interpretation Provider (OpenAI)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-2024-08-06"
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF=1.5
OPENAI_MAX_INPUT_TOKENS=3500
OPENAI_MAX_OUTPUT_TOKENS=2000

# Logging Configuration
LOG_LEVEL="INFO"

# V1 In-Process Job Execution
MAX_WORKER_THREADS=4
