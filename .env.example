# ==============================================================================
# Dataset Doctor - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values for your environment.
# Do NOT commit '.env' to version control.

# Application Settings
APP_NAME="Dataset Doctor"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL 16 Async via asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataset_doctor

# File Ingestion & Storage Settings
# STORAGE_BACKEND options: "local" (default filesystem) or "s3" (S3-compatible object storage)
STORAGE_BACKEND="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=100

# S3-Compatible Object Storage (Required if STORAGE_BACKEND="s3", e.g., Backblaze B2, MinIO, AWS S3)
# Example Backblaze B2 Endpoint: https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT_URL=""
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_SIGNATURE_VERSION="s3v4"

# AI Interpretation Provider (OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-2024-08-06"
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF=1.5
OPENAI_MAX_INPUT_TOKENS=3500
OPENAI_MAX_OUTPUT_TOKENS=2000

# Logging Configuration
LOG_LEVEL="INFO"

# V1 In-Process Job Execution (Single Replica Constraint)
MAX_WORKER_THREADS=4

# Authentication & Session Security
SESSION_COOKIE_NAME="dd_session"
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# CORS & Ingress
# In production, set ALLOWED_ORIGINS to your Vercel frontend URL, e.g. "https://dataset-doctor.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000"
ENABLE_API_DOCS=false
# TRUSTED_PROXIES: Comma-separated list of trusted reverse proxy IPs. Never set to "0.0.0.0/0" or "*" (forbidden in production).
TRUSTED_PROXIES="127.0.0.1,::1"

# Account Resource Quotas & Abuse Prevention
MAX_DATASETS_PER_USER=20
MAX_CUMULATIVE_STORAGE_MB_PER_USER=500
MAX_CONCURRENT_ANALYSIS_JOBS_PER_USER=2
RATE_LIMIT_ANALYSIS_TRIGGERS_PER_MINUTE=10
RATE_LIMIT_AI_EXPLANATIONS_PER_MINUTE=20
RATE_LIMIT_AI_PLANS_PER_MINUTE=10
RATE_LIMIT_REMEDIATIONS_PER_MINUTE=10

# SMTP Email Delivery (Deferred to Phase 3B3; keep REQUIRE_EMAIL_VERIFICATION=false until configured)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=true
EMAIL_FROM="noreply@datasetdoctor.local"
